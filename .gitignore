node_modules/
package-lock.json

localhost.url
LaunchPythonServer.bat

# Docs/ contient un miroir des .md de Documentation/GDD/ et Documentation/Lore/
# Ces fichiers sont SERVIS par Vercel (le site les fetch dynamiquement via MdRenderer).
# Doivent donc etre commit. Source de verite : Documentation/GDD et Documentation/Lore.
# Pour resync : copier le contenu via Copy-Item -Recurse -Force.

# HybeliorFull/ = 207k tiles OpenSeadragon (~777 MB)
# Servies via Cloudflare R2 + Worker proxy : https://hybelior-tiles.nicolas-vollard.workers.dev
# Source de verite locale, upload via rclone vers R2 bucket "hybelior-tiles".
HybeliorFull/

# Secrets & déploiement — ne jamais committer
.env
.env.*
.vercel/

# Données générées localement par server.js (régénérées au démarrage)
local-db.json
local-history.json
local-borders.json
local-highlights.json

# Overlay local du graphe (dev — miroir du magasin Turso, régénérable).
# NB : data/kg-base.json est la base statique et DOIT être committé.
local-kg-overlay.json

# Rapport de diagnostic de l'agrégation lore (régénérable, non versionné).
data/.lore-aggregate-report.json

# Config éditeur Obsidian — ne doit pas être servie publiquement
Docs/Lore/.obsidian/

# Config éditeur Obsidian (état local — ne pas versionner)
.obsidian/
**/.obsidian/

# Base SQLite (transitoire) : reconstruite via `npm run kg:db` depuis data/kg-base.json.
# Le fichier WAL/SHM ne se versionne jamais. (À committer quand la DB deviendra
# la source de vérité de plein droit — voir feuille de route inversion.)
data/hybelior.db
data/hybelior.db-wal
data/hybelior.db-shm
